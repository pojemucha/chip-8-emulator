import { Slider } from "std-widgets.slint";

export component SettingsDialog inherits Rectangle {
    in-out property <int> clock-frequency: 700;
    in-out property <color> fg-color: #cdd6f4;
    in-out property <color> bg-color: #1e1e2e;

    callback save-settings(int, color, color);
    callback cancel-settings();

    width: 480px;
    height: 460px;
    border-radius: 8px;
    background: #2a2a3e;

    property <[color]> palette: [
        #000000, #1d2b53, #7e2553, #008751,
        #ab5236, #5f574f, #c2c3c7, #fff1e8,
        #ff004d, #ffa300, #ffec27, #00e436,
        #29adff, #83769c, #ff77a8,
    ];

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text {
            text: "Settings";
            color: #cdd6f4;
            font-size: 18px;
            font-weight: 700;
        }

        VerticalLayout {
            spacing: 4px;
            Text {
                text: "CPU Clock: \{root.clock-frequency} Hz";
                color: #cdd6f4;
                font-size: 14px;
            }
            Slider {
                minimum: 200;
                maximum: 1200;
                value: root.clock-frequency;
                changed => { root.clock-frequency = self.value; }
            }
        }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: "Active Pixel Color";
                color: #cdd6f4;
                font-size: 14px;
            }
            HorizontalLayout {
                spacing: 6px;
                for c in root.palette: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: c;
                    border-width: root.fg-color == c ? 3px : 1px;
                    border-color: root.fg-color == c ? #cdd6f4 : #585b70;
                    TouchArea {
                        clicked => { root.fg-color = c; }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: "Background Color";
                color: #cdd6f4;
                font-size: 14px;
            }
            HorizontalLayout {
                spacing: 6px;
                for c in root.palette: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: c;
                    border-width: root.bg-color == c ? 3px : 1px;
                    border-color: root.bg-color == c ? #cdd6f4 : #585b70;
                    TouchArea {
                        clicked => { root.bg-color = c; }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Rectangle {
                width: 80px; height: 32px;
                border-radius: 4px;
                background: cancel-touch.has-hover ? #45475a : #313244;
                Text {
                    text: "Cancel"; color: #cdd6f4;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                cancel-touch := TouchArea {
                    clicked => { root.cancel-settings(); }
                }
            }

            Rectangle {
                width: 80px; height: 32px;
                border-radius: 4px;
                background: save-touch.has-hover ? #94e2d5 : #74c7ec;
                Text {
                    text: "Save"; color: #1e1e2e;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                save-touch := TouchArea {
                    clicked => {
                        root.save-settings(root.clock-frequency, root.fg-color, root.bg-color);
                    }
                }
            }
        }
    }
}