export component GameCard inherits Rectangle {
    in property <string>    title;
    in property <string>    size;
    in property <image>     icon;
    in property <color>     card-color: #89b4fa;
    in property <bool>      show-preview: true;
    in property <bool>      force-open: false;
    in property <length>    viewport-width: 800px;

    callback clicked;
    callback hovered(bool);

    width:  144px;
    height: root.force-open ? 132px : 52px;

    out property <bool> is-hovered: card-ta.has-hover || label-ta.has-hover;
    out property <bool> is-closing: !root.force-open && cartridge.height > 52px;

    property <bool> is-open:    root.show-preview && (is-hovered || root.force-open);
    property <bool> open-down:  !root.force-open && root.y < 60px;

    card-ta := TouchArea {
        y: cartridge.y;
        width: cartridge.width;
        height: cartridge.height;
        clicked => { root.clicked(); }
    }

    changed is-hovered => { 
        root.hovered(root.is-hovered); 
    }
    
    cartridge := Rectangle {
        width: 144px;
        height: root.is-open ? 132px : 52px;
        y: (!root.force-open && !root.open-down) ? (52px - self.height) : 0px;

        background: root.is-open ? root.card-color : #313244;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        border-bottom-left-radius: root.is-open ? 2px : 8px;
        border-bottom-right-radius: root.is-open ? 2px : 8px;
        border-width: root.is-open ? 2px : 0px;
        border-color: #11111b;

        animate height, background { duration: 150ms; easing: ease-out; }

        VerticalLayout {
            padding: 8px;
            padding-bottom: root.is-open ? 4px : 8px;
            spacing: 4px;
            alignment: space-between;

            if root.is-open: Rectangle {
                width: 128px;
                height: 64px;
                background: #1e1e2e;
                border-radius: 4px;
                border-width: 1px;
                border-color: #11111b;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.icon;
                    image-fit: fill;
                    image-rendering: pixelated;
                }
            }

            VerticalLayout {
                Rectangle {
                    height: 36px;

                    label-box := Rectangle {
                        width: (label-ta.has-hover && root.is-open)
                            ? max(128px, title-text.preferred-width + 12px)
                            : 128px;

                        property <length> right-edge: parent.absolute-position.x + self.width;
                        property <length> margin: 8px;

                        x: self.right-edge > (root.viewport-width - self.margin)
                            ? (root.viewport-width - self.margin) - self.right-edge
                            : 0px;

                        y: 0px;
                        height: parent.height;

                        background: root.is-open ? #cdd6f4 : transparent;
                        border-width: root.is-open ? 1px : 0px;
                        border-color: root.is-open ? #b6bdd3 : #11111b;
                        border-radius: 4px;

                        animate width, x { duration: 120ms; easing: ease-out; }

                        VerticalLayout {
                            padding-left: root.is-open ? 5px : 0px;
                            padding-right: root.is-open ? 5px : 0px;
                            alignment: center;
                            spacing: 1px;

                            title-text := Text {
                                text: root.title;
                                color: root.is-open ? #11111b : #cdd6f4;
                                font-size: 13px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            Text {
                                text: root.size;
                                color: root.is-open ? #313244 : #6c7086;
                                font-size: 10px;
                            }
                        }

                        label-ta := TouchArea {
                            clicked => { root.clicked(); }
                        }
                    }
                }
            }

            if root.is-open: Rectangle {
                height: 10px;
                background: #181825;
                border-radius: 2px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 2px;
                    spacing: 4px;
                    alignment: center;
                    for _ in 12: Rectangle {
                        width: 6px;
                        height: 8px;
                        background: #f9e2af;
                    }
                }
            }
        }
    }
}
