export component EmulatorView inherits Rectangle {
    in property <image> screen;
    in property <color> bg-color: #11111b;

    background: root.bg-color;

    callback press-key(string);
    callback release-key(string);

    game-scope := FocusScope {
        init => {
            self.focus();
        }

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            Image {
                source: root.screen;
                image-fit: contain;
                image-rendering: pixelated;
                min-width: 256px;
                min-height: 128px;

                TouchArea {
                    clicked => { game-scope.focus(); }
                }
            }
        }

        key-pressed(event) => {
            root.press-key(event.text);
            accept
        }

        key-released(event) => {
            root.release-key(event.text);
            accept
        }
    }
}