export component EmulatorView inherits Rectangle {
    in property <image> screen;
    in property <color> bg-color: #11111b;
    in property <color> fg-color: #cdd6f4;

    background: root.bg-color;

    callback back-to-launcher;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Image {
            source: root.screen;
            image-fit: contain;
            image-rendering: pixelated;
            min-width: 256px;
            min-height: 128px;
        }

        Rectangle {
            width: 160px;
            height: 36px;
            border-radius: 4px;
            background: touch.has-hover ? #45475a : #313244;

            Text {
                text: "Back to Library";
                color: root.fg-color;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                clicked => { root.back-to-launcher(); }
            }
        }
    }
}