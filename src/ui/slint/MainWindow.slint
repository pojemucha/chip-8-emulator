import { LauncherView, GameEntry } from "LauncherView.slint";
import { EmulatorView } from "EmulatorView.slint";
import { SettingsDialog } from "SettingsDialog.slint";

export component MainWindow inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 480px;
    min-height: 360px;
    background: root.settings-bg;

    in-out property <bool> in-game: false;
    in property <[GameEntry]> games;
    in property <image> screen;

    in-out property <bool> drag-hovered: false;

    in-out property <bool> show-settings: false;
    in-out property <int> settings-clock: 700;
    in-out property <color> settings-fg: #cdd6f4;
    in-out property <color> settings-bg: #1e1e2e;
    in-out property <color> fg-color: #cdd6f4;

    callback settings-clicked;
    callback browse-rom-clicked;
    callback game-selected(string);
    callback back-to-launcher;
    callback press-key(string);
    callback release-key(string);
    callback save-settings(int, color, color);

    VerticalLayout {
        Rectangle {
            height: 48px;
            background: #2a2a3e;

            HorizontalLayout {
                padding-top: 8px;
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                if root.in-game:
                    Rectangle {
                        width: 160px;
                        height: 32px;
                        border-radius: 4px;
                        background: touch.has-hover ? #45475a : #313244;

                        Text {
                            text: "Back to Library";
                            color: root.fg-color;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        touch := TouchArea {
                            clicked => { root.back-to-launcher(); }
                        }
                    }

                if !root.in-game:
                    Text {
                        height:32px;
                        text: "Chip-8 Emulator";
                        color: #cdd6f4;
                        font-size: 16px;
                        vertical-alignment: center;
                    }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        width: 100px;
                        height: 32px;
                        border-radius: 4px;
                        background: import-touch.has-hover ? #45475a : #313244;

                        Text {
                            text: "Import ROM";
                            color: #cdd6f4;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        import-touch := TouchArea {
                            clicked => { root.browse-rom-clicked(); }
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 4px;
                        background: settings-touch.has-hover ? #45475a : #313244;

                        Text {
                            text: "⚙";
                            color: #cdd6f4;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        settings-touch := TouchArea {
                            clicked => { root.settings-clicked(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            if !root.in-game: LauncherView {
                games: root.games;
                game-selected(title) => { root.game-selected(title); }
            }

            if root.in-game: EmulatorView {
                screen: root.screen;
                bg-color: root.settings-bg;
                press-key(key) => {root.press-key(key); }
                release-key(key) => {root.release-key(key);}
            }
        }
    }

    Rectangle {
        background: root.drag-hovered ? #45475a80 : #00000000;
    }

    if root.show-settings: Rectangle {
        background: #00000080;

        outside := TouchArea {
            clicked => { }
        }

        SettingsDialog {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            clock-frequency: root.settings-clock;
            fg-color: root.settings-fg;
            bg-color: root.settings-bg;

            save-settings(freq, fg, bg) => {
                root.show-settings = false;
                root.save-settings(freq, fg, bg);
            }
            cancel-settings => {
                root.show-settings = false;
            }
        }
    }
}