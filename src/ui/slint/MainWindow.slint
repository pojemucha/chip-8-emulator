import { LauncherView, GameEntry } from "LauncherView.slint";
import { EmulatorView } from "EmulatorView.slint";
import { SettingsDialog } from "SettingsDialog.slint";

export component MainWindow inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 480px;
    min-height: 360px;
    background: root.settings-bg;

    in-out property <bool> in-game: false;
    in property <[GameEntry]> games;

    in-out property <bool> show-settings: false;
    in-out property <int> settings-clock: 700;
    in-out property <color> settings-fg: #cdd6f4;
    in-out property <color> settings-bg: #1e1e2e;

    callback settings-clicked;
    callback browse-rom-clicked;
    callback game-selected(string);
    callback back-to-launcher;
    callback save-settings(int, color, color);

    pure callback extract-rom-path(data-transfer) -> string;
    callback rom-dropped(string);

    VerticalLayout {
        Rectangle {
            height: 48px;
            background: #2a2a3e;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                Text {
                    text: "Chip-8 Emulator";
                    color: #cdd6f4;
                    font-size: 16px;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        width: 100px;
                        height: 32px;
                        border-radius: 4px;
                        background: import-touch.has-hover ? #45475a : #313244;

                        Text {
                            text: "Import ROM";
                            color: #cdd6f4;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        import-touch := TouchArea {
                            clicked => { root.browse-rom-clicked(); }
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 4px;
                        background: settings-touch.has-hover ? #45475a : #313244;

                        Text {
                            text: "⚙";
                            color: #cdd6f4;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        settings-touch := TouchArea {
                            clicked => { root.settings-clicked(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            if !root.in-game: LauncherView {
                games: root.games;
                game-selected(title) => { root.game-selected(title); }
            }

            if root.in-game: EmulatorView {
                bg-color: root.settings-bg;
                fg-color: root.settings-fg;
                back-to-launcher => { root.back-to-launcher(); }
            }
        }
    }

    Rectangle {
        background: drop.has-drag ? #45475a80 : #00000000;

        drop := DropArea {
            can-drop(event) => {
                root.extract-rom-path(event.data) != ""
                    ? DragAction.copy
                    : DragAction.none;
            }

            dropped(event) => {
                let path = root.extract-rom-path(event.data);
                if path != "" {
                    root.rom-dropped(path);
                }
                DragAction.copy
            }
        }
    }

    if root.show-settings: Rectangle {
        background: #00000080;

        outside := TouchArea {
            clicked => { }
        }

        SettingsDialog {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            clock-frequency: root.settings-clock;
            fg-color: root.settings-fg;
            bg-color: root.settings-bg;

            save-settings(freq, fg, bg) => {
                root.show-settings = false;
                root.save-settings(freq, fg, bg);
            }
            cancel-settings => {
                root.show-settings = false;
            }
        }
    }
}